# Скопируйте в .env.local и задайте свои значения. НИКОГДА не коммитьте .env.local
OWNER_PASSWORD=change-me-long-random          # пароль кабинета мастера (обязателен в production)
SESSION_SECRET=change-me-at-least-16-chars    # ключ подписи сессии (обязателен в production)
DATABASE_DIR=.data/pg                         # папка встроенной БД; "memory" = без сохранения
# EMAIL_PROVIDER_API_KEY=                     # пока не подключено: письма не отправляются
# ANTHROPIC_API_KEY=                          # пока не подключено: ИИ работает по сценарному движку
