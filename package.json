{
  "name": "beauty-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply beauty-os --local",
    "db:remote": "wrangler d1 migrations apply beauty-os --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wrangler": "^4.158.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}